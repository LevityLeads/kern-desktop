{
  "name": "kern-desktop",
  "version": "1.3.0",
  "description": "Electron desktop shell for Kern OS with Windows 11 Mica/Acrylic transparency",
  "main": "main.js",
  "author": {
    "name": "Levity Leads Ltd",
    "email": "rees.calder@levityleads.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:node": "node --test test/*.test.js",
    "test:dotnet": "dotnet test native/Kern.Recorder.sln --configuration Release --no-restore",
    "restore:dotnet": "dotnet restore native/Kern.Recorder.sln --locked-mode",
    "build:helper": "dotnet publish native/Kern.Recorder.Helper/Kern.Recorder.Helper.csproj --configuration Release --runtime win-x64 --self-contained true --output native/Kern.Recorder.Helper/publish/win-x64 --no-restore",
    "build": "electron-builder",
    "build:win": "npm run build:helper && electron-builder --win --publish never",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.15.3"
  }
}
